// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Client",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "${workspaceRoot}/examples/framework-svelte",
        "--extensionDevelopmentPath=${workspaceRoot}/packages/language-tools/vscode"
      ],
      "outFiles": ["${workspaceRoot}/packages/language-tools/vscode/dist/**/*.js"]
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Server",
      "port": 6040,
      "restart": true,
      "outFiles": ["${workspaceRoot}/packages/language-tools/language-server/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Launch Extension",
      "configurations": ["Launch Client", "Attach to Server"]
    }
  ]
}
